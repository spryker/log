{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% set logsCount = collector.logsCount %}
    {% set errorCount = collector.errorCount %}
    {% set icon %}
        <div{% if errorCount > 0 %} style="background-color: #8B4343; padding: 0 4px;"{% endif %}>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                <path fill="#AAA" d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 4l5 2.18V11c0 3.5-2.33 6.79-5 7.93-2.67-1.14-5-4.43-5-7.93V7.18L12 5zm-1 3v4h2V8h-2zm0 6v2h2v-2h-2z"/>
            </svg>
            <span class="sf-toolbar-value">{{ logsCount }}</span>
            {% if errorCount > 0 %}
                <span class="sf-toolbar-status sf-toolbar-status-red">{{ errorCount }}</span>
            {% endif %}
        </div>
    {% endset %}

    {% set text %}
        <div class="sf-toolbar-info-piece">
            <b>Audit Logs</b>
            <span class="sf-toolbar-status">{{ logsCount }}</span>
        </div>
        {% if errorCount > 0 %}
            <div class="sf-toolbar-info-piece">
                <b>Errors</b>
                <span class="sf-toolbar-status sf-toolbar-status-red">{{ errorCount }}</span>
            </div>
        {% endif %}
        {% for channel in collector.channels %}
            <div class="sf-toolbar-info-piece">
                <b>{{ channel }}</b>
                <span>{{ collector.logsByChannel(channel)|length }}</span>
            </div>
        {% endfor %}
    {% endset %}

    {% include '@WebProfiler/Profiler/toolbar_item.html.twig' with { 'link': profiler_url } %}
{% endblock %}

{% block menu %}
    {% set logsCount = collector.logsCount %}
    {% set errorCount = collector.errorCount %}
    <span class="label {% if errorCount > 0 %}label-status-error{% endif %}">
        <span class="icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                <path fill="#AAA" d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 4l5 2.18V11c0 3.5-2.33 6.79-5 7.93-2.67-1.14-5-4.43-5-7.93V7.18L12 5zm-1 3v4h2V8h-2zm0 6v2h2v-2h-2z"/>
            </svg>
        </span>
        <strong>Audit Log</strong>
        <span class="count">
            <span>{{ logsCount }}</span>
        </span>
    </span>
{% endblock %}

{% block panel %}
    <style>
        /* ── Tabs ── */
        .audit-log-tabs {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            margin-bottom: 24px;
            padding-bottom: 0;
        }
        .audit-log-tab {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 20px;
            border: 1px solid #d8d8d8;
            background: #f3f3f3;
            color: #666;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            user-select: none;
            transition: background 0.12s, color 0.12s, border-color 0.12s;
        }
        .audit-log-tab:hover {
            background: #e8e8e8;
            color: #333;
            border-color: #bbb;
        }
        .audit-log-tab.active {
            background: #2e3d50;
            border-color: #2e3d50;
            color: #fff;
            font-weight: 600;
        }
        .audit-log-tab-content { display: none; }
        .audit-log-tab-content.active { display: block; }

        /* ── Count badges inside tabs ── */
        .audit-log-badge {
            display: inline-block;
            min-width: 18px;
            padding: 1px 6px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 700;
            text-align: center;
            background: rgba(0, 0, 0, 0.12);
            color: inherit;
        }
        .audit-log-tab.active .audit-log-badge {
            background: rgba(255, 255, 255, 0.22);
            color: #fff;
        }
        .audit-log-badge.is-error {
            background: #e53935;
            color: #fff;
        }

        /* ── Level pills ── */
        .audit-log-level {
            display: inline-block;
            padding: 2px 7px;
            border-radius: 3px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            white-space: nowrap;
        }
        .audit-log-level-debug     { background: #90a4ae; color: #fff; }
        .audit-log-level-info      { background: #42a5f5; color: #fff; }
        .audit-log-level-notice    { background: #26c6da; color: #fff; }
        .audit-log-level-warning   { background: #ffa726; color: #fff; }
        .audit-log-level-error     { background: #ef5350; color: #fff; }
        .audit-log-level-critical  { background: #b71c1c; color: #fff; }
        .audit-log-level-alert     { background: #880e4f; color: #fff; }
        .audit-log-level-emergency { background: #4a148c; color: #fff; }

        /* ── Table ── */
        .audit-log-table {
            table-layout: auto;
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }
        .audit-log-table .col-shrink {
            white-space: nowrap;
            width: 1%;
        }
        .audit-log-table .col-fill {
            width: 99%;
        }
        .audit-log-table th {
            background: #2e3d50;
            color: #fff;
            padding: 9px 10px;
            text-align: left;
            font-weight: 600;
            font-size: 12px;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }
        .audit-log-table td {
            padding: 8px 10px;
            vertical-align: top;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            background: transparent;
        }
        .audit-log-table tbody tr.audit-log-row-even td {
            background: rgba(255, 255, 255, 0.03);
        }
        .audit-log-table code {
            background: #eef1f5;
            padding: 1px 5px;
            border-radius: 3px;
            font-size: 12px;
            color: #3c4c60;
        }
        .audit-log-table pre {
            white-space: pre-wrap;
            word-wrap: break-word;
            margin: 0;
            font-size: 12px;
        }

        /* ── Context row ── */
        .audit-log-context-row td {
            padding-top: 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        .audit-log-context-row.audit-log-row-even td {
            background: rgba(255, 255, 255, 0.03);
        }
        .audit-log-row-has-context td {
            border-bottom: none;
        }
        .audit-log-context-cell {
            padding: 6px 10px 10px 10px;
        }
        .audit-log-context-content {
            border-radius: 4px;
            padding: 10px 14px;
            margin-top: 4px;
            overflow-x: auto;
            max-height: 500px;
            overflow-y: auto;
        }

        /* ── Context expand ── */
        .audit-log-table details {
            padding-top: 4px;
        }
        .audit-log-table details summary {
            display: inline-block;
            cursor: pointer;
            font-size: 12px;
            color: #ccc;
            font-weight: 500;
            padding: 3px 10px;
            border-radius: 3px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.06);
            user-select: none;
            transition: background 0.12s, border-color 0.12s, color 0.12s;
        }
        .audit-log-table details summary:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(255, 255, 255, 0.35);
            color: #fff;
        }
        .audit-log-table details[open] summary {
            margin-bottom: 6px;
            background: #2e3d50;
            border-color: #2e3d50;
            color: #fff;
        }

        /* ── Empty state ── */
        .audit-log-empty {
            padding: 40px 20px;
            text-align: center;
            color: #999;
            font-size: 14px;
            border: 1px dashed #ddd;
            border-radius: 6px;
        }
    </style>

    <h2>Audit Logs</h2>

    {% set allLogs = collector.logs %}
    {% set channels = collector.channels %}
    {% set errorCount = collector.errorCount %}

    <div class="audit-log-tabs" role="tablist">
        <button type="button" role="tab" aria-selected="true" aria-controls="audit-tab-all" class="audit-log-tab active" onclick="showAuditTab('all', this)">
            All
            <span class="audit-log-badge {% if errorCount > 0 %}is-error{% endif %}">{{ allLogs|length }}</span>
        </button>
        {% for channel in channels %}
            <button type="button" role="tab" aria-selected="false" aria-controls="audit-tab-{{ channel|replace({':': '-', '_': '-'})|e('html_attr') }}" class="audit-log-tab" onclick="showAuditTab('{{ channel|replace({':': '-', '_': '-'})|e('js') }}', this)">
                {{ channel }}
                <span class="audit-log-badge">{{ collector.logsByChannel(channel)|length }}</span>
            </button>
        {% endfor %}
    </div>

    <div id="audit-tab-all" role="tabpanel" class="audit-log-tab-content active">
        {{ _self.renderLogsTable(allLogs) }}
    </div>

    {% for channel in channels %}
        <div id="audit-tab-{{ channel|replace({':': '-', '_': '-'})|e('html_attr') }}" role="tabpanel" class="audit-log-tab-content">
            {{ _self.renderLogsTable(collector.logsByChannel(channel)) }}
        </div>
    {% endfor %}

    <script>
        function showAuditTab(tabId, el) {
            document.querySelectorAll('.audit-log-tab-content').forEach(function(c) { c.classList.remove('active'); });
            document.querySelectorAll('.audit-log-tab').forEach(function(t) {
                t.classList.remove('active');
                t.setAttribute('aria-selected', 'false');
            });

            var tab = document.getElementById('audit-tab-' + tabId);

            if (tab) { tab.classList.add('active'); }

            el.classList.add('active');
            el.setAttribute('aria-selected', 'true');
        }
    </script>
{% endblock %}

{% macro renderLogsTable(logs) %}
    {% if logs is empty %}
        <div class="audit-log-empty">
            No audit log records were captured for this request.
        </div>
    {% else %}
        <table class="audit-log-table">
            <thead>
                <tr>
                    <th class="col-shrink">#</th>
                    <th class="col-shrink">Time</th>
                    <th class="col-shrink">Channel</th>
                    <th class="col-shrink">Level</th>
                    <th class="col-fill">Message</th>
                </tr>
            </thead>
            <tbody>
                {% for i, log in logs %}
                    <tr class="{% if i is even %}audit-log-row-even{% endif %}{% if log.context is not empty %} audit-log-row-has-context{% endif %}">
                        <td class="col-shrink">{{ i + 1 }}</td>
                        <td class="col-shrink">{{ log.time }}</td>
                        <td class="col-shrink"><code>{{ log.channel }}</code></td>
                        <td class="col-shrink">
                            <span class="audit-log-level audit-log-level-{{ log.level|lower|e('html_attr') }}">{{ log.level }}</span>
                        </td>
                        <td>{{ log.message }}</td>
                    </tr>
                    {% if log.context is not empty %}
                        <tr class="audit-log-context-row {% if i is even %}audit-log-row-even{% endif %}">
                            <td colspan="5" class="audit-log-context-cell">
                                <details>
                                    <summary>Show context</summary>
                                    <div class="audit-log-context-content">
                                        {{ profiler_dump(log.context) }}
                                    </div>
                                </details>
                            </td>
                        </tr>
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endmacro %}
