parameters:
    level: 7
    ignoreErrors:
        - '#Strict comparison using === between '''' and ''GLUE'' will always evaluate to false.#'
        - '#Strict comparison using === between '''' and ''YVES'' will always evaluate to false.#'
        - '#Strict comparison using === between '''' and ''ZED'' will always evaluate to false.#'
        - '#Strict comparison using === between 2 and 1 will always evaluate to false.#'
        - '#Else branch is unreachable because previous condition is always true#'
        - '#Call to an undefined method .+HandlerInterface::close\(\)#'
        - '#Parameter \#2 \$level of class .+StreamHandler constructor expects .+, int(.*?) given#'
        - '#Parameter .+ of method .+AbstractHandler::__construct\(\) expects .+, int\|string given.#'
        - '#Parameter \#1 \$record of method .+HandlerInterface::isHandling\(\) expects .+, array given.#'
        - '#Parameter \#1 \$record of method .+HandlerInterface::handle\(\) expects .+, array(<mixed>)? given.#'
        - '#Parameter \#1 \$record of method .+ProcessorInterface::__invoke\(\) expects .+, array(<mixed>)? given.#'
        - '#Parameter \#1 \$record of method .+PsrLogMessageProcessor::__invoke\(\) expects .+, array(<mixed>)? given.#'
        - '#Parameter \#3 \$level of class .+BufferHandler constructor expects .+, int\|string given.#'
        - '#Parameter \#3 \$level of method .+BufferHandler::__construct\(\) expects .+, int\|string given.#'
        - '#Parameter \#1 \$level of static method Monolog\\Logger::toMonologLevel\(\) expects .+, int\|string given.#'
        - '#Instanceof between Monolog\\Level and Monolog\\Level will always evaluate to true.#'
        - '#Parameter \#1 \$record of method .+BufferHandler::handle\(\) expects .+, array(<[a-z, ]+>)?\|Monolog\\LogRecord given.#'
        - '#PHPDoc tag @SuppressWarnings has invalid value#'
        - '#PHPDoc tag @var with type .+HandlerInterface is not subtype of native type#'
        - '#Call to function method_exists\(\) with .+HandlerInterface and ''close'' will always evaluate to true#'
        - '#Strict comparison using !== between .+SessionInterface and null will always evaluate to true#'
        - '#PHPDoc tag @return has invalid value .+\*#'
        -
            identifier: missingType.iterableValue
        -
            identifier: missingType.return
        -
            identifier: trait.unused
    reportUnmatchedIgnoredErrors: false
